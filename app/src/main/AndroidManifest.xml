<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- targetSdk 28 keeps legacy external storage: these two runtime grants
         give the on-device agent full read/write path access to /sdcard.
         (Scoped-storage READ_MEDIA_* perms are NOT needed at this target.) -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <!-- Battery exemption request (ACTION_REQUEST_IGNORE_BATTERY_OPTIMIZATIONS):
         the server must survive overnight suspension — Android battery
         optimization killed the process tree on Aug 28 and again Sep 20
         (server offline ~7h, stale cloud connection). targetSdk 28 keeps
         this permission usable on modern Android. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Self-updater (v0.4.0): lets the app ASK to install the downloaded
         update APK. The actual grant is the user's one-time "install
         unknown apps" decision in system settings — Android routes the
         request there and refuses installs without it. Signature safety
         is enforced by the OS at install time (mismatched signing
         certificates are rejected), so a hijacked feed cannot install a
         different app. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:label="Letta Environment"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:extractNativeLibs="true"
        android:theme="@android:style/Theme.DeviceDefault.DayNight">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|density|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".LettaEnvironmentService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <service
            android:name=".AgentAccessibilityService"
            android:exported="false"
            android:label="@string/a11y_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/agent_accessibility_config" />
        </service>

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Self-updater: serves the downloaded update APK to the system
             installer (content:// URI — file:// ACTION_VIEW is banned on
             API 24+). Scope is only the app's own external-files updates
             dir; nothing else is shareable. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
